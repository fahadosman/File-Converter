{
  "name": "file-converters",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:minify:js": "terser public/script.js -c -m -o public/script.min.js",
    "build:minify:css": "cleancss -o public/styles.min.css public/styles.css",
    "build:minify:html": "html-minifier-terser --collapse-whitespace --remove-comments --minify-css true --minify-js true -o public/index.min.html public/index.html",
    "build:minify": "npm run build:minify:js && npm run build:minify:css && npm run build:minify:html",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {},
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.46.1",
    "wrangler": "^4.13.2"
  }
}
